# MED-AI provider keys — read server-side by api/medai.js (Vercel Function and
# the Vite dev/preview middleware). They are NOT compiled into the browser bundle.
# Recommended names below; the legacy VITE_* names (VITE_GROQ_API_KEY,
# VITE_GEMINI_API_KEY, VITE_OPENROUTER_API_KEY, VITE_HUGGINGFACE_API_KEY) also work.
# Leave all blank to run from the onboard deterministic engine.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# Optional: extra origins allowed to call /api/medai (comma-separated).
# MEDAI_ALLOWED_ORIGINS=https://example.com
